+class ExactSourceInverseTests(unittest.TestCase):
+    def test_original_source_conversion_alias_is_explicitly_unknown(self):
+        a, b = 8_500_000_000_000_001, 8_500_000_000_000_002
+        self.assertEqual(source_seconds(a), source_seconds(b))
+        with self.assertRaisesRegex(ValueError, 'ambiguous_nanosecond_inverse'):
+            m.seconds_ns(source_seconds(a))
+
+    def test_exact_inverse_matches_independent_preimages_at_float_and_second_boundaries(self):
+        # Exhaust a local integer oracle about known original stamps. The
+        # production inverse searches its entire domain, not this oracle window.
+        limit = 2**53
+        origins = (0, 1_000_000_000, (2**23-1)*1_000_000_000,
+                   2**23*1_000_000_000, 8_500_000_000_000_000, limit-1_000_000_000)
+        conversions = {'stamp_parts': source_seconds, 'nanoseconds_product': lambda ns: ns*1e-9}
+        for origin in origins:
+            for offset in (-3, -2, -1, 0, 1, 2, 3, 999_999_998, 999_999_999):
+                ns = origin+offset
+                if not 0 <= ns < limit:
+                    continue
+                for name, encode in conversions.items():
+                    value = encode(ns)
+                    if not value < limit/1e9:
+                        continue
+                    preimages = [candidate for candidate in range(max(0, ns-8), min(limit, ns+9))
+                                 if encode(candidate) == value]
+                    with self.subTest(ns=ns, conversion=name, preimages=preimages):
+                        if len(preimages) == 1:
+                            self.assertEqual(m.seconds_ns(value, conversion=name), preimages[0])
+                        else:
+                            with self.assertRaisesRegex(ValueError, 'ambiguous_nanosecond_inverse'):
+                                m.seconds_ns(value, conversion=name)
+
+    def test_unique_large_source_stamp_is_supported_without_arbitrary_low_cutoff(self):
+        ns = 8_500_000_000_000_000
+        self.assertEqual(m.seconds_ns(source_seconds(ns)), ns)
+
+    def test_publication_uses_actual_product_not_stamp_parts(self):
+        native, diag = pair()
+        header = 10_250_000_000
+        ns = next(header+i for i in range(1, 1000)
+                  if (header+i)*1e-9 != source_seconds(header+i))
+        diag['output_publication_s'] = ns*1e-9
+        self.assertEqual(m.validate_pair(native, diag), 10_000_000_000)
+        diag['output_publication_s'] = source_seconds(ns)
+        with self.assertRaisesRegex(ValueError, 'not_exact_nanosecond_roundtrip'):
+            m.validate_pair(native, diag)
+
