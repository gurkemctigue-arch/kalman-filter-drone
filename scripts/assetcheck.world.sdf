<?xml version="1.0"?>
<sdf version="1.10">
  <world name="assetcheck">
    <gravity>0 0 -9.81</gravity>
    <physics name="default" type="ignored"><max_step_size>0.004</max_step_size><real_time_factor>1</real_time_factor></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.58 0.67 0.80 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>0.2 -0.3 -0.9</direction></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.25 0.32 0.23 1</ambient><diffuse>0.36 0.43 0.31 1</diffuse></material></visual></link></model>
    <model name="person_camera"><static>true</static><pose>0 0 3 0 0.30 0</pose><link name="link"><sensor name="rgbd" type="rgbd_camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/asset/person</topic><camera><horizontal_fov>1.04719755</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30</far></clip><optical_frame_id>camera_link</optical_frame_id></camera></sensor></link></model>
    <model name="car_camera"><static>true</static><pose>0 20 3 0 0.20 0</pose><link name="link"><sensor name="rgbd" type="rgbd_camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/asset/car</topic><camera><horizontal_fov>1.04719755</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30</far></clip><optical_frame_id>camera_link</optical_frame_id></camera></sensor></link></model>
    <model name="person_asset"><static>true</static><pose>6 0 0 0 0 1.57</pose><link name="link"><visual name="visual"><geometry><mesh><uri>model://fuel_walking_person/meshes/walking.dae</uri></mesh></geometry></visual></link></model>
    <model name="car_asset"><static>true</static><pose>9 20 0 0 0 -0.8</pose><link name="link"><visual name="visual"><geometry><mesh><uri>model://fuel_prius_hybrid/meshes/Hybrid.obj</uri><scale>0.01 0.01 0.01</scale></mesh></geometry></visual></link></model>
    <model name="hatchback_camera"><static>true</static><pose>0 -20 3 0 0.20 0</pose><link name="link"><sensor name="rgbd" type="rgbd_camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/asset/hatchback</topic><camera><horizontal_fov>1.04719755</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30</far></clip><optical_frame_id>camera_link</optical_frame_id></camera></sensor></link></model>
    <model name="hatchback_asset"><static>true</static><pose>9 -20 0 0 0 -0.8</pose><link name="link"><visual name="visual"><geometry><mesh><uri>model://fuel_hatchback/meshes/hatchback.obj</uri><scale>0.0254 0.0254 0.0254</scale></mesh></geometry></visual></link></model>
    <model name="suv_camera"><static>true</static><pose>0 -40 3 0 0.20 0</pose><link name="link"><sensor name="rgbd" type="rgbd_camera"><always_on>true</always_on><update_rate>10</update_rate><topic>/asset/suv</topic><camera><horizontal_fov>1.04719755</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.1</near><far>30</far></clip><optical_frame_id>camera_link</optical_frame_id></camera></sensor></link></model>
    <model name="suv_asset"><static>true</static><pose>9 -40 0 0 0 -0.8</pose><link name="link"><visual name="visual"><geometry><mesh><uri>model://fuel_suv/meshes/suv.obj</uri><scale>0.06 0.06 0.06</scale></mesh></geometry></visual></link></model>
  </world>
</sdf>
