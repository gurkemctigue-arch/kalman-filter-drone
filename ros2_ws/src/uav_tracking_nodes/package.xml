<?xml version="1.0"?>
<package format="3">
  <name>uav_tracking_nodes</name>
  <version>0.1.0</version>
  <description>ROS 2 detector, estimator, and controller nodes for RGB-D UAV tracking.</description>
  <maintainer email="maintainer@example.invalid">UAV tracking project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>uav_tracking_interfaces</depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
