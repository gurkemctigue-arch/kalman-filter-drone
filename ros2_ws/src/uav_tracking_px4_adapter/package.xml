<?xml version="1.0"?>
<package format="3">
  <name>uav_tracking_px4_adapter</name>
  <version>0.1.0</version>
  <description>ROS/PX4 adapter with explicit ENU to NED conversion and offboard heartbeat.</description>
  <maintainer email="maintainer@example.invalid">UAV tracking project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>nav_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>uav_tracking_interfaces</depend>
  <exec_depend>px4_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
