<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset><unit name="meter" meter="1"/><up_axis>Z_UP</up_axis></asset>
  <library_geometries>
    <geometry id="personMesh" name="personMesh">
      <mesh>
        <source id="personPositions"><float_array id="personPositionsArray" count="24">-0.22 -0.17 0 0.22 -0.17 0 0.22 0.17 0 -0.22 0.17 0 -0.22 -0.17 1.7 0.22 -0.17 1.7 0.22 0.17 1.7 -0.22 0.17 1.7</float_array><technique_common><accessor source="#personPositionsArray" count="8" stride="3"><param name="X" type="float"/><param name="Y" type="float"/><param name="Z" type="float"/></accessor></technique_common></source>
        <vertices id="personVertices"><input semantic="POSITION" source="#personPositions"/></vertices>
        <triangles count="12"><input semantic="VERTEX" source="#personVertices" offset="0"/><p>0 1 2 0 2 3 4 6 5 4 7 6 0 4 5 0 5 1 1 5 6 1 6 2 2 6 7 2 7 3 3 7 4 3 4 0</p></triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes><visual_scene id="Scene"><node id="Person"><instance_geometry url="#personMesh"/></node></visual_scene></library_visual_scenes>
  <scene><instance_visual_scene url="#Scene"/></scene>
</COLLADA>
