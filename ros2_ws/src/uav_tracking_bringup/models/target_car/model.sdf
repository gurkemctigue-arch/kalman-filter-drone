<?xml version="1.0"?>
<sdf version="1.10">
  <model name="target_car">
    <static>false</static>
    <link name="link">
      <!-- Scripted ground-plane actor: rendering/depth use the visual mesh.
           No ground-contact dynamics are part of the tracking experiment. -->
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0.70 0 0 0</pose>
        <mass>1200.0</mass>
        <inertia><ixx>550.0</ixx><iyy>2300.0</iyy><izz>2500.0</izz></inertia>
      </inertial>
      <!-- CC0 Fuel Prius Hybrid v3. Native front -Y becomes model +X. -->
      <visual name="textured_car">
        <pose>0 0 0.02 0 0 1.57079633</pose>
        <geometry><mesh><uri>model://fuel_prius_hybrid/meshes/Hybrid.obj</uri><scale>0.01 0.01 0.01</scale></mesh></geometry>
      </visual>
    </link>
    <!-- Test-environment motion only; velocities are in model coordinates. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/scenario/target/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
    <!-- Evaluation-only target pose stream. Runtime association must not
         subscribe to this topic or use the model name/entity ID. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>-1</update_frequency>
      <topic>/ground_truth/poses</topic>
    </plugin>
  </model>
</sdf>
