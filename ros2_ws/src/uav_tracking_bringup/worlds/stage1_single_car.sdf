<?xml version="1.0"?>
<sdf version="1.10">
  <!-- Same deterministic sensor rig and timing as stage1_single_target.sdf;
       only the target class/trajectory changes. Keep this world single-target
       so AUTO_UNIQUE has an unambiguous acceptance condition. -->
  <world name="stage1_single_car">
    <gravity>0 0 -9.81</gravity>
    <physics name="1ms" type="ode"><max_step_size>0.001</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <!-- SceneBroadcaster's dynamic_pose/info is bridged only for offline
         evaluation; no runtime node may use actor/model IDs. -->
    <scene><ambient>0.4 0.4 0.4 1</ambient><background>0.08 0.10 0.14 1</background><shadows>true</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0.25 -0.45 0.3</pose><diffuse>0.85 0.85 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular><direction>-0.3 0.2 -1.0</direction></light>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry><material><ambient>0.16 0.18 0.20 1</ambient><diffuse>0.22 0.24 0.27 1</diffuse></material></visual></link></model>
    <model name="uav_camera_rig"><static>true</static><pose>0 0 3.0 0 0.18 0</pose><link name="base_link"><visual name="body_visual"><geometry><box><size>0.45 0.45 0.16</size></box></geometry><material><ambient>0.05 0.12 0.22 1</ambient><diffuse>0.08 0.22 0.42 1</diffuse></material></visual><sensor name="rgbd_camera" type="rgbd_camera"><always_on>true</always_on><visualize>true</visualize><update_rate>30</update_rate><topic>/camera/rgbd</topic><camera><horizontal_fov>1.04719755</horizontal_fov><image><width>640</width><height>480</height><format>R8G8B8</format></image><clip><near>0.10</near><far>50.0</far></clip><depth_camera><output>depths</output><clip><near>0.10</near><far>50.0</far></clip></depth_camera><optical_frame_id>camera_link</optical_frame_id></camera></sensor></link></model>
    <!-- The textured car is a normal model so it renders without an actor
         animation skeleton.  Its pose is reserved for offline ground truth. -->
    <include>
      <uri>model://target_car</uri>
      <name>target_car</name>
      <pose>9 3 0 0 0 3.14159</pose>
    </include>
  </world>
</sdf>
