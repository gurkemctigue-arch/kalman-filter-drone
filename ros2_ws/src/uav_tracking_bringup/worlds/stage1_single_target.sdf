<?xml version="1.0"?>
<sdf version="1.10">
  <!--
    Deterministic, simulator-only stage-one world.

    The camera and targets publish ordinary sensor/pose topics.  The pose
    publisher is for offline evaluation and rosbag recording only; no runtime
    node is allowed to use the target model name or pose vector for tracking.
    The target paths are intentionally simple and repeatable so that the same
    world can be used for the raw/EMA/fixed-KF/adaptive-KF comparisons.
  -->
  <world name="stage1_single_target">
    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- SceneBroadcaster's dynamic_pose/info is bridged only for offline
         evaluation and rosbag recording. Runtime tracking must use RGB-D
         observations and TF, never simulator truth. -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0.25 -0.45 0.3</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1.0</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.16 0.18 0.20 1</ambient>
            <diffuse>0.22 0.24 0.27 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!--
      A stationary RGB-D camera rig is used for the first sensor/estimator
      smoke test.  A PX4 vehicle can replace this model later while retaining
      the sensor names and frame convention.  Camera optical +Z is aligned
      with the Gazebo camera forward axis by the adapter's TF configuration.
    -->
    <model name="uav_camera_rig">
      <static>true</static>
      <pose>0 0 3.0 0 0.18 0</pose>
      <link name="base_link">
        <inertial><mass>1.0</mass><inertia><ixx>0.01</ixx><iyy>0.01</iyy><izz>0.01</izz></inertia></inertial>
        <visual name="body_visual">
          <geometry><box><size>0.45 0.45 0.16</size></box></geometry>
          <material><ambient>0.05 0.12 0.22 1</ambient><diffuse>0.08 0.22 0.42 1</diffuse></material>
        </visual>
        <sensor name="rgbd_camera" type="rgbd_camera">
          <always_on>true</always_on>
          <visualize>true</visualize>
          <update_rate>30</update_rate>
          <topic>/camera/rgbd</topic>
          <camera>
            <horizontal_fov>1.04719755</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.10</near><far>50.0</far></clip>
            <depth_camera>
              <output>depths</output>
              <clip><near>0.10</near><far>50.0</far></clip>
            </depth_camera>
            <optical_frame_id>camera_link</optical_frame_id>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- This world contains exactly one visible textured person. The target is a
         normal model rather than an actor because the local COLLADA asset is
         intentionally static and has no animation skeleton.  Its pose remains
         simulator truth for offline evaluation only. -->
    <include>
      <uri>model://target_person</uri>
      <name>target_person</name>
      <pose>5 0 0 0 0 0</pose>
    </include>

  </world>
</sdf>
