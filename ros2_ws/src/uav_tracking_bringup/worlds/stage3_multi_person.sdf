<?xml version="1.0"?>
<sdf version="1.10">
  <world name="stage3_flight">
    <gravity>0 0 -9.81</gravity><magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field><atmosphere type="adiabatic"/>
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>1.0</real_time_factor><real_time_update_rate>250</real_time_update_rate></physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>
    <scene><ambient>0.6 0.6 0.6 1</ambient><background>0.65 0.75 0.9 1</background><shadows>false</shadows></scene>
    <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><direction>-0.3 0.2 -1</direction><diffuse>0.9 0.9 0.9 1</diffuse><specular>0.1 0.1 0.1 1</specular></light>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>47.397971</latitude_deg><longitude_deg>8.546164</longitude_deg><elevation>0</elevation></spherical_coordinates>
    <model name="ground"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry><material><ambient>0.32 0.36 0.29 1</ambient><diffuse>0.45 0.48 0.38 1</diffuse></material></visual></link></model>
    <!-- The same physics world contains PX4 and three independently commanded
         same-class rendered objects. GT streams are evaluation-only. -->
    <include><uri>model://x500_stage3</uri><name>stage1_uav</name><pose>0 0 0.25 0 0 0</pose></include>
  <model name="stage2_person_0">
    <pose>5 0 0 0 0 0</pose>
    <static>false</static>
    <link name="link">
      <!-- Scripted ground-plane actor: rendering/depth use the visual mesh.
           No ground-contact dynamics are part of the tracking experiment. -->
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0.95 0 0 0</pose>
        <mass>70.0</mass>
        <inertia><ixx>20.0</ixx><iyy>20.0</iyy><izz>2.0</izz></inertia>
      </inertial>
      <!-- CC0 Fuel Walking person v3; texture paths remain relative to DAE. -->
      <visual name="textured_person">
        <pose>0 0 -0.02 0 0 1.57079633</pose>
        <geometry><mesh><uri>model://fuel_walking_person/meshes/walking.dae</uri></mesh></geometry>
      </visual>
    </link>
    <!-- Test-environment motion only; velocities are in model coordinates. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/scenario/target_0/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
    <!-- Evaluation-only target pose stream. Runtime association must not
         subscribe to this topic or use the model name/entity ID. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
      <topic>/ground_truth/poses</topic>
    </plugin>
  </model>
  <model name="stage2_person_1">
    <pose>8 -2 0 0 0 0</pose>
    <static>false</static>
    <link name="link">
      <!-- Scripted ground-plane actor: rendering/depth use the visual mesh.
           No ground-contact dynamics are part of the tracking experiment. -->
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0.95 0 0 0</pose>
        <mass>70.0</mass>
        <inertia><ixx>20.0</ixx><iyy>20.0</iyy><izz>2.0</izz></inertia>
      </inertial>
      <!-- CC0 Fuel Walking person v3; texture paths remain relative to DAE. -->
      <visual name="textured_person">
        <pose>0 0 -0.02 0 0 1.57079633</pose>
        <geometry><mesh><uri>model://fuel_walking_person/meshes/walking.dae</uri></mesh></geometry>
      </visual>
    </link>
    <!-- Test-environment motion only; velocities are in model coordinates. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/scenario/target_1/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
    <!-- Evaluation-only target pose stream. Runtime association must not
         subscribe to this topic or use the model name/entity ID. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
      <topic>/ground_truth/poses</topic>
    </plugin>
  </model>
  <model name="stage2_person_2">
    <pose>11 2 0 0 0 0</pose>
    <static>false</static>
    <link name="link">
      <!-- Scripted ground-plane actor: rendering/depth use the visual mesh.
           No ground-contact dynamics are part of the tracking experiment. -->
      <gravity>false</gravity>
      <inertial>
        <pose>0 0 0.95 0 0 0</pose>
        <mass>70.0</mass>
        <inertia><ixx>20.0</ixx><iyy>20.0</iyy><izz>2.0</izz></inertia>
      </inertial>
      <!-- CC0 Fuel Walking person v3; texture paths remain relative to DAE. -->
      <visual name="textured_person">
        <pose>0 0 -0.02 0 0 1.57079633</pose>
        <geometry><mesh><uri>model://fuel_walking_person/meshes/walking.dae</uri></mesh></geometry>
      </visual>
    </link>
    <!-- Test-environment motion only; velocities are in model coordinates. -->
    <plugin filename="gz-sim-velocity-control-system"
            name="gz::sim::systems::VelocityControl">
      <topic>/scenario/target_2/cmd_vel</topic>
      <initial_linear>0 0 0</initial_linear>
      <initial_angular>0 0 0</initial_angular>
    </plugin>
    <!-- Evaluation-only target pose stream. Runtime association must not
         subscribe to this topic or use the model name/entity ID. -->
    <plugin filename="gz-sim-pose-publisher-system"
            name="gz::sim::systems::PosePublisher">
      <publish_model_pose>true</publish_model_pose>
      <publish_link_pose>false</publish_link_pose>
      <publish_sensor_pose>false</publish_sensor_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <update_frequency>30</update_frequency>
      <topic>/ground_truth/poses</topic>
    </plugin>
  </model>
    <!-- Test-driver-only rendering shutter; no collision and no target ID. -->
    <model name="vision_shutter"><static>true</static><pose>0 0 -50 0 0 0</pose><link name="link"><visual name="opaque"><geometry><box><size>0.05 3 3</size></box></geometry><material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.02 0.02 0.02 1</diffuse></material></visual></link></model>
  </world>
</sdf>
